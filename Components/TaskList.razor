@using LifeRPG.Models
@using System.Globalization

<section>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="text-white m-0">
            📋 Задачи на @SelectedDate.ToString("dd MMMM (ddd)", RuCulture)
        </h4>
        <button class="btn btn-sm btn-success fw-bold" @onclick="OnAddTaskClicked">
            + Добавить задачу на этот день
        </button>
    </div>

    @{
        var selectedDayTasks = Quests.Where(q => q.TargetDate.Date == SelectedDate.Date).ToList();
    }

    @if (!selectedDayTasks.Any())
    {
        <div class="alert alert-dark border-secondary text-center text-muted">
            На этот день задач пока нет. Вы можете накидать их через кнопку выше!
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var quest in selectedDayTasks)
            {
                <div class="list-group-item bg-black text-white border-secondary d-flex justify-content-between align-items-center mb-2 rounded @(quest.IsCompleted ? "opacity-50" : "")">
                    <div>
                        <h5 class="mb-1">
                            @if (quest.ScheduledTime.HasValue)
                            {
                                <span class="badge bg-warning text-dark me-2 fs-6 fw-bold">
                                    ⏱️ @quest.GetFormattedTimeRange()
                                </span>
                            }
                            <span class="text-white">@quest.Title</span>
                        </h5>
                        <small class="text-info fw-bold">+@quest.GetCalculatedReward() gold | Длительность: @(quest.DurationMinutes / 60) ч @(quest.DurationMinutes % 60) мин</small>
                    </div>

                    <div>
                        @if (quest.IsCompleted)
                        {
                            <span class="badge bg-success fs-6">Выполнено 🎉</span>
                        }
                        else if (quest.IsSkipped)
                        {
                            <span class="badge bg-secondary fs-6">Задач нет 🛌</span>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-primary me-2 fw-bold" @onclick="() => OnCompleteQuest.InvokeAsync(quest)">
                                Выполнить
                            </button>

                            @if (quest.Type == QuestType.Study)
                            {
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => OnSkipQuest.InvokeAsync(quest)">
                                    Сегодня учебы нет
                                </button>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    }
</section>

@code {
    [Parameter] public DateTime SelectedDate { get; set; }
    [Parameter] public List<QuestItem> Quests { get; set; } = new();
    [Parameter] public EventCallback<QuestItem> OnCompleteQuest { get; set; }
    [Parameter] public EventCallback<QuestItem> OnSkipQuest { get; set; }
    [Parameter] public EventCallback OnAddTaskClicked { get; set; }

    private CultureInfo RuCulture = new CultureInfo("ru-RU");
}