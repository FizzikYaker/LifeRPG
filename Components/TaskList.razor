@using LifeRPG.Models
@using System.Globalization

<section class="card border-0 text-white mb-4 p-4 shadow-lg rounded-4 task-list-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="text-white m-0 fw-bold">
            📋 Задачи на @SelectedDate.ToString("dd MMMM (ddd)", RuCulture)
        </h4>
        <button class="btn btn-sm btn-outline-success fw-bold px-3 py-2 rounded-3 add-task-btn" @onclick="OnAddTaskClicked">
            + Добавить задачу
        </button>
    </div>

    @{
        var selectedDayTasks = Quests.Where(q => q.TargetDate.Date == SelectedDate.Date).ToList();
    }

    @if (!selectedDayTasks.Any())
    {
        <div class="p-4 rounded-3 text-center text-slate-400 empty-tasks-box">
            На этот день задач пока нет. Нажмите кнопку выше, чтобы запланировать квест!
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-2">
            @foreach (var quest in selectedDayTasks)
            {
                <div class="task-item p-3 rounded-3 d-flex justify-content-between align-items-center @(quest.IsCompleted ? "task-completed-item" : "")">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            @if (quest.ScheduledTime.HasValue)
                            {
                                <span class="badge time-badge">
                                    ⏱️ @quest.GetFormattedTimeRange()
                                </span>
                            }
                            <h5 class="m-0 fw-bold @(quest.IsCompleted ? "text-decoration-line-through text-muted" : "text-white")">
                                @quest.Title
                            </h5>
                        </div>
                        <small class="text-warning fw-bold">+@quest.GetCalculatedReward() gold</small>
                        <span class="text-slate-500 mx-1">|</span>
                        <small class="text-slate-400">Длительность: @(quest.DurationMinutes / 60) ч @(quest.DurationMinutes % 60) мин</small>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        @if (quest.IsCompleted)
                        {
                            <span class="badge bg-success-subtle text-success border border-success px-3 py-2 rounded-pill fw-bold">Выполнено 🎉</span>
                        }
                        else if (quest.IsSkipped)
                        {
                            <span class="badge bg-secondary-subtle text-secondary border border-secondary px-3 py-2 rounded-pill fw-bold">Отменено 🛌</span>
                        }
                        else
                        {
                            <button class="btn btn-primary btn-sm px-3 fw-bold action-btn" @onclick="() => OnCompleteQuest.InvokeAsync(quest)">
                                Выполнить
                            </button>

                            @if (quest.Type == QuestType.Study)
                            {
                                <button class="btn btn-outline-secondary btn-sm px-3" @onclick="() => OnSkipQuest.InvokeAsync(quest)">
                                    Учебы нет
                                </button>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    }
</section>

<style>
    .task-list-card {
        background: #0b1329;
        border: 1px solid #1e293b !important;
    }

    .task-item {
        background: #111c35;
        border: 1px solid #1e293b;
        transition: all 0.2s ease;
    }

        .task-item:hover {
            border-color: #38bdf8;
        }

    .task-completed-item {
        opacity: 0.6;
        background: #0d1627;
    }

    .time-badge {
        background: rgba(245, 158, 11, 0.15);
        color: #f59e0b;
        border: 1px solid rgba(245, 158, 11, 0.3);
        font-weight: 600;
    }

    .add-task-btn {
        border-color: #22c55e;
        color: #22c55e;
    }

        .add-task-btn:hover {
            background: #22c55e;
            color: #000000;
        }

    .empty-tasks-box {
        border: 1px dashed #1e293b;
        background: #0e172a;
    }

    .text-slate-400 {
        color: #94a3b8;
    }

    .text-slate-500 {
        color: #64748b;
    }
</style>

@code {
    [Parameter] public DateTime SelectedDate { get; set; }
    [Parameter] public List<QuestItem> Quests { get; set; } = new();
    [Parameter] public EventCallback<QuestItem> OnCompleteQuest { get; set; }
    [Parameter] public EventCallback<QuestItem> OnSkipQuest { get; set; }
    [Parameter] public EventCallback OnAddTaskClicked { get; set; }

    private CultureInfo RuCulture = new CultureInfo("ru-RU");
}