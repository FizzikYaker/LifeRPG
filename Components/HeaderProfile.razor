@using LifeRPG.Models

<header class="d-flex justify-content-between align-items-center p-3 text-white border-bottom shadow-lg sticky-top z-3 header-rpg">
    <div class="fs-5 fw-bold d-flex align-items-center gap-2">
        <span>🔥</span> Стрик: <span class="text-danger fw-extrabold streak-glow">@Streak дней</span>
    </div>

    <div class="fs-4 fw-bold gold-badge px-3 py-1 rounded-pill">
        🪙 <span class="text-warning">@Player.GoldBalance</span> <small class="fs-6 text-warning opacity-75">GOLD</small>
    </div>

    <div class="d-flex align-items-center gap-3">
        <span class="fs-5 fw-bold level-text">Уровень @Player.Level</span>
        <div class="progress rounded-pill bg-dark border border-secondary" style="width: 200px; height: 22px;">
            @{
                var progressPercent = (Player.CurrentXP * 100) / Player.RequiredXP;
            }
            <div class="progress-bar bg-gradient-success rounded-pill fw-bold text-dark fs-6" style="width: @(progressPercent)%">
                @(progressPercent)%
            </div>
        </div>
    </div>
</header>

<style>
    .header-rpg {
        background: #080e1e;
        border-color: #1e293b !important;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);
    }

    .gold-badge {
        background: rgba(245, 158, 11, 0.1);
        border: 1px solid rgba(245, 158, 11, 0.3);
        box-shadow: 0 0 15px rgba(245, 158, 11, 0.15);
    }

    .level-text {
        color: #e2e8f0;
        text-shadow: 0 0 10px rgba(56, 189, 248, 0.3);
    }

    .bg-gradient-success {
        background: linear-gradient(90deg, #10b981, #34d399);
        box-shadow: 0 0 10px rgba(52, 211, 153, 0.5);
    }

    .streak-glow {
        text-shadow: 0 0 10px rgba(239, 68, 68, 0.5);
    }
</style>

@code {
    [Parameter] public PlayerProfile Player { get; set; } = new();
    [Parameter] public int Streak { get; set; }
}