@using LifeRPG.Models

<header class="d-flex justify-content-between align-items-center p-3 bg-black border-bottom border-secondary shadow-sm flex-shrink-0 sticky-top z-3">
    <div class="fs-5 fw-bold">
        🔥 Стрик: <span class="text-danger">@Streak дней</span>
    </div>

    <div class="fs-4 fw-bold">
        💰 Золото: <span class="text-warning">@Player.GoldBalance gold</span>
    </div>

    <div class="d-flex align-items-center gap-2">
        <span class="fs-5 fw-bold me-2">Уровень @Player.Level</span>
        <div class="progress rounded-pill bg-secondary" style="width: 180px; height: 22px;">
            @{
                var progressPercent = (Player.CurrentXP * 100) / Player.RequiredXP;
            }
            <div class="progress-bar bg-success rounded-pill fw-bold text-dark" style="width: @(progressPercent)%">
                @(progressPercent)%
            </div>
        </div>
    </div>
</header>

@code {
    [Parameter] public PlayerProfile Player { get; set; } = new();
    [Parameter] public int Streak { get; set; }
}

