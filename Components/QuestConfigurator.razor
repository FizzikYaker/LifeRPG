@using LifeRPG.Models

<section class="card border-0 text-white p-4 shadow-lg rounded-4 add-task-card">
    <h4 class="text-success mb-3 fw-bold">➕ Новая задача</h4>

    <div class="mb-3">
        <label class="form-label text-slate-300">Название:</label>
        <input class="form-control" @bind="newTaskTitle" placeholder="Например: Дописать отчёт" />
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <label class="form-label text-slate-300">Тип:</label>
            <select class="form-select" @bind="newTaskType">
                <option value="@QuestType.PetProject">Проект/хобби</option>
                <option value="@QuestType.Study">Учеба</option>
                <option value="@QuestType.Daily">Привычка</option>
                <option value="@QuestType.OneTime">Разовая</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label text-slate-300">Длительность (мин):</label>
            <input type="number" class="form-control" @bind="newTaskDuration" />
        </div>
        <div class="col-md-3">
            <label class="form-label text-slate-300">Награда (Gold):</label>
            <input type="number" class="form-control" @bind="newTaskReward" />
        </div>
        <div class="col-md-3">
            <label class="form-label text-slate-300">Дата:</label>
            <input type="date" class="form-control" @bind="newTaskDate" />
        </div>
    </div>

    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" @bind="autoSchedule" id="autoScheduleCheck" />
        <label class="form-check-label text-slate-300" for="autoScheduleCheck">
            Поставить автоматически на ближайший свободный день
        </label>
    </div>

    <button class="btn btn-success fw-bold px-4" @onclick="SubmitTask">💾 Создать</button>
</section>

@code {
    [Parameter] public ScheduleConfig Config { get; set; } = new ScheduleConfig();
    [Parameter] public List<QuestItem> Templates { get; set; } = new List<QuestItem>();
    [Parameter] public DateTime InitialDate { get; set; } = DateTime.Today;

    [Parameter] public EventCallback<(QuestItem Task, bool AutoSchedule)> OnTaskCreated { get; set; }

    private string newTaskTitle = "";
    private DateTime newTaskDate = DateTime.Today;
    private int newTaskReward = 300;
    private int newTaskDuration = 60;
    private QuestType newTaskType = QuestType.PetProject;
    private bool autoSchedule = true;

    protected override void OnParametersSet()
    {
        newTaskDate = InitialDate >= DateTime.Today ? InitialDate : DateTime.Today;
    }

    private async Task SubmitTask()
    {
        if (string.IsNullOrWhiteSpace(newTaskTitle)) return;

        var quest = new QuestItem
        {
            Title = newTaskTitle,
            RewardGold = newTaskReward,
            DurationMinutes = newTaskDuration,
            Type = newTaskType,
            TargetDate = newTaskDate,
            ScheduledTime = new TimeSpan(20, 0, 0)
        };

        await OnTaskCreated.InvokeAsync((quest, autoSchedule));
        newTaskTitle = "";
    }
}