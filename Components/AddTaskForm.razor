@code {
    [Parameter] public DateTime InitialDate { get; set; } = DateTime.Today;

    // Если передаем и задачу, и флаг автораспределения:
    [Parameter] public EventCallback<(QuestItem Task, bool AutoSchedule)> OnTaskCreated { get; set; }

    private string newTaskTitle = "";
    private DateTime newTaskDate = DateTime.Today;
    private int newTaskReward = 300;
    private int newTaskDuration = 60;
    private QuestType newTaskType = QuestType.PetProject;

    // Переменная автоподбора (исправляет CS0103)
    private bool autoSchedule = false;

    protected override void OnParametersSet()
    {
        newTaskDate = InitialDate >= DateTime.Today ? InitialDate : DateTime.Today;
    }

    private async Task SubmitTask()
    {
        if (string.IsNullOrWhiteSpace(newTaskTitle)) return;

        var quest = new QuestItem
        {
            Title = newTaskTitle,
            RewardGold = newTaskReward,
            DurationMinutes = newTaskDuration,
            Type = newTaskType,
            TargetDate = newTaskDate,
            ScheduledTime = new TimeSpan(20, 00, 0)
        };

        // Вызываем событие, передавая кортеж (Task, AutoSchedule)
        await OnTaskCreated.InvokeAsync((quest, autoSchedule));
        newTaskTitle = "";
    }
}