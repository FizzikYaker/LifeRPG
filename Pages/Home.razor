@page "/"
@using LifeRPG.Models
@using System.Globalization

<PageTitle>Life RPG — Главный экран</PageTitle>

@* Главный контейнер на весь экран *@
<div class="d-flex flex-column vh-100 bg-dark text-white overflow-hidden">

    @* ==================== 1. ФИКСИРОВАННАЯ ШАПКА ==================== *@
    <header class="d-flex justify-content-between align-items-center p-3 bg-black border-bottom border-secondary shadow-sm flex-shrink-0">
        <div class="fs-5 fw-bold">
            🔥 Стрик: <span class="text-danger">@currentStreak дней</span>
        </div>

        <div class="fs-4 fw-bold">
            💰 Золото: <span class="text-warning">@player.GoldBalance gold</span>
        </div>

        <div class="d-flex align-items-center gap-2">
            <span class="fs-5 fw-bold me-2">Уровень @player.Level</span>
            <div class="progress rounded-pill bg-secondary" style="width: 180px; height: 22px;">
                @{
                    var progressPercent = (player.CurrentXP * 100) / player.RequiredXP;
                }
                <div class="progress-bar bg-success rounded-pill fw-bold text-dark" style="width: @(progressPercent)%">
                    @(progressPercent)%
                </div>
            </div>
        </div>
    </header>

    @* Нижний блок: Меню + Контент *@
    <div class="d-flex flex-grow-1 overflow-hidden">

        @* ==================== 2. БОКОВОЕ МЕНЮ ==================== *@
        <nav class="p-3 bg-black border-end border-secondary flex-shrink-0" style="width: 220px;">
            <ul class="nav nav-pills flex-column gap-2">
                <li class="nav-item">
                    <button class="nav-link text-white w-100 text-start @(activeTab == "work" ? "active bg-primary fw-bold" : "")"
                            @onclick='() => activeTab = "work"'>
                        🛠️ Расписание и Задачи
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link text-white w-100 text-start @(activeTab == "money" ? "active bg-primary fw-bold" : "")"
                            @onclick='() => activeTab = "money"'>
                        💳 Магазин наград
                    </button>
                </li>
            </ul>
        </nav>

        @* ==================== 3. ОСНОВНОЙ КОНТЕНТ ==================== *@
        <main class="flex-grow-1 p-4 overflow-auto">

            @if (activeTab == "work")
            {
                @* 📊 БЛОК 1: КАЛЬКУЛЯТОР БЮДЖЕТА ВРЕМЕНИ (24 ЧАСА) *@
                <section class="card bg-black border-primary text-white mb-4 p-3 shadow">
                    <h5 class="card-title text-info mb-3">⏱️ Суточный бюджет времени (24 часа)</h5>
                    <div class="row text-center mb-2">
                        <div class="col-md-3">
                            <span class="d-block text-light opacity-75">🛌 Сон</span>
                            <strong class="fs-5 text-white">@sleepHours ч</strong>
                        </div>
                        <div class="col-md-3">
                            <span class="d-block text-light opacity-75">🚗 Дорога</span>
                            <strong class="fs-5 text-white">@commuteHours ч</strong>
                        </div>
                        <div class="col-md-3">
                            <span class="d-block text-light opacity-75">📋 Занято задачами</span>
                            <strong class="fs-5 text-warning">@GetTotalTasksHours() ч</strong>
                        </div>
                        <div class="col-md-3">
                            <span class="d-block text-light opacity-75">🎉 Свободный остаток</span>
                            <strong class="fs-5 @(GetFreeHours() < 0 ? "text-danger" : "text-success")">
                                @GetFreeHours() ч
                            </strong>
                        </div>
                    </div>
                </section>

                @* 📅 БЛОК 2: ДИНАМИЧЕСКИЙ КАЛЕНДАРЬ С ДАТАМИ ПК *@
                <section class="card bg-secondary text-white mb-4 p-3 shadow border-0">
                    <h5 class="card-title mb-3 text-warning">📅 Календарь на 7 дней (с сегодняшнего дня)</h5>
                    <div class="d-flex justify-content-between text-center gap-2">
                        @foreach (var day in weekDays)
                        {
                            var isToday = day.Date == DateTime.Today;
                            <div class="p-2 bg-dark rounded flex-fill border @(isToday ? "border-warning border-2 bg-black" : "border-secondary")">
                                @* Яркие контрастные цвета вместо блеклого серого *@
                                <small class="d-block text-info fw-bold">@day.ToString("ddd, dd.MM", ruCulture)</small>
                                <strong class="@(isToday ? "text-warning" : "text-white")">
                                    @(isToday ? "Сегодня 🌟" : "План 📝")
                                </strong>
                            </div>
                        }
                    </div>
                </section>

                @* ➕ БЛОК 3: ФОРМА ДОБАВЛЕНИЯ СВОЕЙ ЗАДАЧИ *@
                <section class="card bg-black border-secondary p-3 mb-4 shadow">
                    <h5 class="text-success mb-3">➕ Добавить новую задачу</h5>
                    <div class="row g-2 align-items-center">
                        <div class="col-md-4">
                            <input type="text" class="form-control bg-dark text-white border-secondary"
                                   placeholder="Название задачи..." @bind="newTaskTitle" />
                        </div>
                        <div class="col-md-2">
                            <input type="number" class="form-control bg-dark text-white border-secondary"
                                   placeholder="Gold..." @bind="newTaskReward" />
                        </div>
                        <div class="col-md-2">
                            <input type="number" class="form-control bg-dark text-white border-secondary"
                                   placeholder="Длительность (мин)..." @bind="newTaskDuration" />
                        </div>
                        <div class="col-md-2">
                            <select class="form-select bg-dark text-white border-secondary" @bind="newTaskType">
                                <option value="@QuestType.WorkShift">Работа</option>
                                <option value="@QuestType.Study">Учеба</option>
                                <option value="@QuestType.PetProject">Pet-проект</option>
                                <option value="@QuestType.Daily">Привычка</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-success w-100 fw-bold" @onclick="AddNewTask">
                                Добавить
                            </button>
                        </div>
                    </div>
                </section>

                @* ⏰ БЛОК 4: СПИСОК ЗАДАЧ *@
                <section>
                    <h5 class="mb-3 text-white">⏰ Задачи на сегодня</h5>
                    <div class="list-group">
                        @foreach (var quest in quests)
                        {
                            <div class="list-group-item bg-black text-white border-secondary d-flex justify-content-between align-items-center mb-2 rounded @(quest.IsCompleted ? "opacity-50" : "")">
                                <div>
                                    <h5 class="mb-1">
                                        @if (quest.ScheduledTime.HasValue)
                                        {
                                            @* Контрастная плашка времени *@
                                            <span class="badge bg-warning text-dark me-2 fs-6 fw-bold">
                                                ⏱️ @quest.GetFormattedTimeRange()
                                            </span>
                                        }
                                        <span class="text-white">@quest.Title</span>
                                    </h5>
                                    <small class="text-info fw-bold">+@quest.GetCalculatedReward() gold | Длительность: @(quest.DurationMinutes / 60) ч @(quest.DurationMinutes % 60) мин</small>
                                </div>

                                <div>
                                    @if (quest.IsCompleted)
                                    {
                                        <span class="badge bg-success fs-6">Выполнено 🎉</span>
                                    }
                                    else if (quest.IsSkipped)
                                    {
                                        <span class="badge bg-secondary fs-6">Задач нет 🛌</span>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-primary me-2 fw-bold" @onclick="() => CompleteQuest(quest)">
                                            Выполнить
                                        </button>

                                        @if (quest.Type == QuestType.Study)
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => SkipQuest(quest)">
                                                Сегодня учебы нет
                                            </button>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }
            else if (activeTab == "money")
            {
                <section>
                    <h4 class="mb-3">💳 Финансы и Магазин наград</h4>
                    <div class="row">
                        @foreach (var reward in rewards)
                        {
                            <div class="col-md-4 mb-3">
                                <div class="card bg-black text-white border-secondary h-100 text-center">
                                    <div class="card-body">
                                        <h5>🎁 @reward.Title</h5>
                                        <p class="text-warning fs-5 fw-bold">@reward.PriceGold gold</p>
                                        <button class="btn btn-warning w-100 fw-bold"
                                                disabled="@(player.GoldBalance < reward.PriceGold)"
                                                @onclick="() => BuyReward(reward)">
                                            Купить
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }

        </main>
    </div>
</div>

@code {
    private PlayerProfile player = new PlayerProfile();
    private int currentStreak = 5;
    private string activeTab = "work";

    // Настройки времени сна и дороги (в часах)
    private int sleepHours = 8;
    private int commuteHours = 2;

    // Поля для формы создания новой задачи (@bind)
    private string newTaskTitle = "";
    private int newTaskReward = 300;
    private int newTaskDuration = 60;
    private QuestType newTaskType = QuestType.PetProject;

    private CultureInfo ruCulture = new CultureInfo("ru-RU");

    private List<DateTime> weekDays => Enumerable.Range(0, 7)
        .Select(offset => DateTime.Today.AddDays(offset))
        .ToList();

    private List<QuestItem> quests = new List<QuestItem>
    {
        new QuestItem {
            Title = "Дневная смена на работе",
            RewardGold = 500,
            Type = QuestType.WorkShift,
            ScheduledTime = new TimeSpan(08, 00, 0),
            DurationMinutes = 720 // 12 часов
        },
        new QuestItem {
            Title = "Учеба: Задание от куратора",
            RewardGold = 400,
            Type = QuestType.Study,
            ScheduledTime = new TimeSpan(20, 30, 0),
            DurationMinutes = 60 // 1 час
        }
    };

    private List<RewardItem> rewards = new List<RewardItem>
    {
        new RewardItem { Title = "Попить пива вечером", PriceGold = 100 },
        new RewardItem { Title = "Просмотр фильма / сериала", PriceGold = 150 },
        new RewardItem { Title = "Заказать пиццу / фастфуд", PriceGold = 400 },
        new RewardItem { Title = "Весь день играть в видеоигры", PriceGold = 800 }
    };

    // --- МЕТОДЫ РАСЧЕТА БЮДЖЕТА ВРЕМЕНИ ---

    // Считает общее количество часов, занятых квестами
    private double GetTotalTasksHours()
    {
        int totalMinutes = quests.Where(q => !q.IsSkipped).Sum(q => q.DurationMinutes);
        return Math.Round(totalMinutes / 60.0, 1);
    }

    // Считает свободный остаток от 24 часов
    private double GetFreeHours()
    {
        double usedHours = sleepHours + commuteHours + GetTotalTasksHours();
        return Math.Round(24.0 - usedHours, 1);
    }

    // Добавление новой задачи из формы
    private void AddNewTask()
    {
        if (string.IsNullOrWhiteSpace(newTaskTitle)) return;

        quests.Add(new QuestItem
        {
            Title = newTaskTitle,
            RewardGold = newTaskReward,
            DurationMinutes = newTaskDuration,
            Type = newTaskType,
            ScheduledTime = new TimeSpan(21, 30, 0) // Ставим по умолчанию вечернее время
        });

        // Сбрасываем поле ввода
        newTaskTitle = "";
    }

    private void CompleteQuest(QuestItem quest)
    {
        quest.IsCompleted = true;
        player.AddGoldAndXP(quest.GetCalculatedReward());
    }

    private void SkipQuest(QuestItem quest)
    {
        quest.SkipTask();
    }

    private void BuyReward(RewardItem reward)
    {
        player.TrySpendGold(reward.PriceGold);
    }
}