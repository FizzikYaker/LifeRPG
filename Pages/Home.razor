@* @page — указывает URL-адрес страницы ("/" значит главная страница) *@
@page "/"

@* Подключаем наши модели из папки LifeRPG.Models *@
@using LifeRPG.Models

<PageTitle>Life RPG — Профиль</PageTitle>

<div class="container mt-4">

    @* ==================== БЛОК 1: ПРОФИЛЬ ИГРОКА ==================== *@
    <div class="card bg-dark text-white mb-4 shadow">
        <div class="card-body text-center">
            @* Имя и текущий уровень *@
            <h2 class="card-title">⚔️ @player.Name (Уровень @player.Level)</h2>

            @* Баланс золота *@
            <h3 class="text-warning my-3">💰 @player.GoldBalance золота</h3>

            @* Шкала опыта (XP Progress Bar) *@
            <div class="mb-2 text-start">
                <small>Опыт: @player.CurrentXP / @player.RequiredXP XP</small>
            </div>
            <div class="progress bg-secondary" style="height: 20px;">
                @* Рассчитываем процент заполнения шкалы *@
                @{
                    var progressPercent = (player.CurrentXP * 100) / player.RequiredXP;
                }
                <div class="progress-bar bg-success progress-bar-striped progress-bar-animated"
                     role="progressbar"
                     style="width: @(progressPercent)%">
                    @(progressPercent)%
                </div>
            </div>
        </div>
    </div>

    @* ==================== БЛОК 2: СПИСОК КВЕСТОВ ==================== *@
    <h3 class="mb-3">📜 Квесты и привычки</h3>
    <div class="row">
        @* Цикл @foreach проходит по всем квестам из списка quests *@
        @foreach (var quest in quests)
        {
            <div class="col-md-6 mb-3">
                @* Если квест выполнен или пропущен, карточка станет полупрозрачной *@
                <div class="card h-100 @(quest.IsCompleted ? "border-success opacity-75" : quest.IsSkipped ? "border-secondary opacity-50" : "")">
                    <div class="card-body">
                        <h5 class="card-title">
                            @* Иконка в зависимости от типа квеста *@
                            @if (quest.Type == QuestType.WorkShift)
                            {
                                <span>🛠️</span>
                            }
                            else if (quest.Type == QuestType.Study)
                            {

                                <span>📚</span>
                            }
                            else if (quest.Type == QuestType.PetProject)
                            {

                                <span>💻</span>
                            }
                            else
                            {

                                <span>💧</span>
                            }

                            @quest.Title
                        </h5>

                        <p class="card-text text-muted">
                            Награда: <strong class="text-warning">+@quest.GetCalculatedReward() gold</strong>
                        </p>

                        @* Статусы и кнопки *@
                        @if (quest.IsCompleted)
                        {
                            <span class="badge bg-success">Выполнено! 🎉</span>
                        }
                        else if (quest.IsSkipped)
                        {
                            <span class="badge bg-secondary">Отменено (без штрафа) 🛌</span>
                        }
                        else
                        {
                            @* Кнопка выполнения *@
                            <button class="btn btn-primary me-2" @onclick="() => CompleteQuest(quest)">
                                Выполнить
                            </button>

                            @* Кнопка пропуск учебы (если тип квеста — Study) *@
                            @if (quest.Type == QuestType.Study)
                            {
                                <button class="btn btn-outline-secondary" @onclick="() => SkipQuest(quest)">
                                    Сегодня учебы нет
                                </button>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @* ==================== БЛОК 3: МАГАЗИН НАГРАД ==================== *@
    <h3 class="my-4">🏪 Магазин наград</h3>
    <div class="row mb-5">
        @foreach (var reward in rewards)
        {
            <div class="col-md-4 mb-3">
                <div class="card text-center h-100">
                    <div class="card-body">
                        <h5 class="card-title">🎁 @reward.Title</h5>
                        <p class="card-text text-danger fs-5">
                            <strong>@reward.PriceGold gold</strong>
                        </p>

                        @* Кнопка покупки: отключается (disabled), если не хватает золота *@
                        <button class="btn btn-warning w-100"
                                disabled="@(player.GoldBalance < reward.PriceGold)"
                                @onclick="() => BuyReward(reward)">
                            Купить
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

</div>
@* ==================== БЛОК C#-ЛОГИКИ (@code) ==================== *@
@code {
    // 1. Создаем объект игрока
    private PlayerProfile player = new PlayerProfile();

    // 2. Тестовый список квестов
    private List<QuestItem> quests = new List<QuestItem>
    {
        new QuestItem { Title = "Дневная смена на работе", RewardGold = 500, Type = QuestType.WorkShift },
        new QuestItem { Title = "Ночная смена на работе", RewardGold = 500, Type = QuestType.WorkShift, IsNightShift = true },
        new QuestItem { Title = "Учеба: Задание от куратора (1 час)", RewardGold = 400, Type = QuestType.Study },
        new QuestItem { Title = "Кодинг C# / Life RPG (1 час)", RewardGold = 300, Type = QuestType.PetProject },
        new QuestItem { Title = "Выпил 2л воды / Не ел фастфуд", RewardGold = 100, Type = QuestType.Daily }
    };

    // 3. Тестовый список наград в магазине
    private List<RewardItem> rewards = new List<RewardItem>
    {
        new RewardItem { Title = "Попить пива вечером", PriceGold = 100 },
        new RewardItem { Title = "Просмотр фильма / сериала", PriceGold = 150 },
        new RewardItem { Title = "Заказать пиццу / фастфуд", PriceGold = 400 },
        new RewardItem { Title = "Весь день играть в видеоигры", PriceGold = 800 }
    };

    // Метод выполнения квеста
    private void CompleteQuest(QuestItem quest)
    {
        quest.IsCompleted = true;                     // Помечаем выполненным
        player.AddGoldAndXP(quest.GetCalculatedReward()); // Начисляем золото и опыт
    }

    // Метод отмены учебы ("Сегодня учебы нет")
    private void SkipQuest(QuestItem quest)
    {
        quest.SkipTask(); // Вызываем метод пропуска без штрафа
    }

    // Метод покупки в магазине
    private void BuyReward(RewardItem reward)
    {
        player.TrySpendGold(reward.PriceGold); // Списываем золото
    }
}
