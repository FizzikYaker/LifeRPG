@page "/"
@using LifeRPG.Models
@using LifeRPG.Components

@* @inject = "дай мне готовый объект из DI". Мы больше не создаём конфиг сами через new *@
@inject ScheduleConfig scheduleConfig
@inject ShiftScheduleService shiftService

<PageTitle>Life RPG — Главный экран</PageTitle>

<div class="d-flex flex-column vh-100 rpg-app-bg text-white overflow-hidden">

    <HeaderProfile Player="player" Streak="currentStreak" />

    <div class="d-flex flex-grow-1 overflow-hidden">

        <nav class="p-3 border-end flex-shrink-0 rpg-sidebar" style="width: 240px;">
            <ul class="nav nav-pills flex-column gap-2">
                <li class="nav-item">
                    <button class="nav-link w-100 text-start sidebar-btn @(activeTab == "work" ? "active-tab" : "")"
                            @onclick='() => activeTab = "work"'>
                        🛠️ Задачи и Календарь
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link w-100 text-start sidebar-btn @(activeTab == "config" ? "active-tab" : "")"
                            @onclick='() => activeTab = "config"'>
                        ⚙️ График и Пул квестов
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link w-100 text-start sidebar-btn @(activeTab == "money" ? "active-tab-warning" : "")"
                            @onclick='() => activeTab = "money"'>
                        💳 Магазин наград
                    </button>
                </li>

            </ul>
        </nav>

        <main class="flex-grow-1 p-4 overflow-auto">

            @if (activeTab == "work")
            {
                <TimeBudgetCard SelectedDate="selectedDate"
                                CompletedHours="GetCompletedTasksHours(selectedDate)"
                                TotalHours="GetTotalTasksHours(selectedDate)"
                                CommuteHours="GetCommuteHours(selectedDate)"
                                FreeHours="GetFreeHours(selectedDate)"
                                IsNightShift="shiftService.IsNightShift(selectedDate)" />

                <ShiftCalendar CurrentMonth="currentMonth"
                               SelectedDate="selectedDate"
                               Quests="quests"
                               OnDateSelected="SelectDate"
                               OnPrevMonth="PrevMonth"
                               OnNextMonth="NextMonth" />

                <TaskList SelectedDate="selectedDate"
                          Quests="quests"
                          OnCompleteQuest="CompleteQuest"
                          OnSkipQuest="SkipQuest"
                          OnAddTaskClicked='() => activeTab = "add-task"' />
            }
            else if (activeTab == "config")
            {
                <ScheduleConfigPanel Config="scheduleConfig" Templates="questTemplates" OnConfigUpdated="() => { }" />
            }
            else if (activeTab == "add-task")
            {
                <AddTaskForm InitialDate="selectedDate"
                             OnTaskCreated="HandleTaskCreated" />
            }
            else if (activeTab == "money")
            {
                <RewardShop Player="player"
                            Rewards="rewards"
                            OnBuyReward="BuyReward" />
            }

        </main>
    </div>
</div>

<style>
    .rpg-app-bg {
        background: #070d19;
    }

    .rpg-sidebar {
        background: #080e1e;
        border-color: #1e293b !important;
    }

    .sidebar-btn {
        color: #94a3b8;
        border-radius: 10px;
        padding: 12px 16px;
        font-weight: 600;
        transition: all 0.2s ease;
        border: 1px solid transparent;
    }

        .sidebar-btn:hover {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.05);
        }

    .active-tab {
        background: rgba(56, 189, 248, 0.15) !important;
        color: #38bdf8 !important;
        border-color: rgba(56, 189, 248, 0.4) !important;
        box-shadow: 0 0 12px rgba(56, 189, 248, 0.2);
    }

    .active-tab-success {
        background: rgba(34, 197, 94, 0.15) !important;
        color: #4ade80 !important;
        border-color: rgba(34, 197, 94, 0.4) !important;
        box-shadow: 0 0 12px rgba(34, 197, 94, 0.2);
    }

    .active-tab-warning {
        background: rgba(245, 158, 11, 0.15) !important;
        color: #fbbf24 !important;
        border-color: rgba(245, 158, 11, 0.4) !important;
        box-shadow: 0 0 12px rgba(245, 158, 11, 0.2);
    }
</style>

@code {
    private static readonly TimeSpan PlanDayStart = new TimeSpan(8, 0, 0);
    private static readonly TimeSpan PlanDayEnd = new TimeSpan(22, 0, 0);

    private PlayerProfile player = new PlayerProfile();
    private int currentStreak = 5;
    private string activeTab = "work";
    private DateTime selectedDate = DateTime.Today;
    private DateTime currentMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);

    private List<QuestItem> quests = new List<QuestItem>
    {
        new QuestItem {
            Title = "Дневная смена на работе",
            RewardGold = 500,
            Type = QuestType.WorkShift,
            ScheduledTime = new TimeSpan(08, 00, 0),
            DurationMinutes = 720,
            TargetDate = DateTime.Today,
            IsCompleted = true
        },
        new QuestItem {
            Title = "Учеба: Задание от куратора",
            RewardGold = 400,
            Type = QuestType.Study,
            ScheduledTime = new TimeSpan(20, 30, 0),
            DurationMinutes = 60,
            TargetDate = DateTime.Today
        }
    };

    private List<RewardItem> rewards = new List<RewardItem>
    {
        new RewardItem { Title = "Попить пива вечером", PriceGold = 100 },
        new RewardItem { Title = "Просмотр фильма / сериала", PriceGold = 150 },
        new RewardItem { Title = "Заказать пиццу / фастфуд", PriceGold = 400 },
        new RewardItem { Title = "Весь день играть в видеоигры", PriceGold = 800 }
    };

    private void PrevMonth() => currentMonth = currentMonth.AddMonths(-1);
    private void NextMonth() => currentMonth = currentMonth.AddMonths(1);
    private void SelectDate(DateTime date) => selectedDate = date;


    private double GetTotalTasksHours(DateTime date) =>
        Math.Round(quests.Where(q => q.TargetDate.Date == date.Date && !q.IsSkipped).Sum(q => q.DurationMinutes) / 60.0, 1);

    private double GetCompletedTasksHours(DateTime date) =>
        Math.Round(quests.Where(q => q.TargetDate.Date == date.Date && q.IsCompleted).Sum(q => q.DurationMinutes) / 60.0, 1);

    // Сколько часов уйдёт на дорогу в конкретный день.
    // IsWorkDay вернёт true для дневной смены, ночной смены и обычного рабочего дня (5/2, гибкий).
    // В выходной (Off) ехать никуда не надо, поэтому 0.
    private int GetCommuteHours(DateTime date) =>
        shiftService.IsWorkDay(date) ? scheduleConfig.CommuteHours : 0;

    // Свободные часы за день = 24 − дорога (только в рабочие дни) − запланированные задачи.
    // Math.Round(..., 1) оставляет один знак после запятой (например, 9.5).
    private double GetFreeHours(DateTime date) =>
        Math.Round(24.0 - (GetCommuteHours(date) + GetTotalTasksHours(date)), 1);

    private Task<string?> HandleTaskCreated((QuestItem Task, bool AutoSchedule) args)
    {
        var task = args.Task;

        if (args.AutoSchedule)
        {
            // Автоподбор: ищем и день, и время начала
            var found = FindDayForTask(task.DurationMinutes, DateTime.Today, 365);

            if (found == null)
            {
                return Task.FromResult<string?>(
                    "Не нашёл свободного дня на ближайший год. " +
                    "Уменьшите длительность задачи или увеличьте лимит нагрузки в настройках графика.");
            }

            task.TargetDate = found.Value.Date;
            task.ScheduledTime = found.Value.Start;
        }
        else
        {
            // Ручной выбор даты: день задан, но время начала всё равно подбираем,
            // чтобы задача не легла поверх других
            var start = FindFreeStart(task.TargetDate, task.DurationMinutes);

            if (start == null)
            {
                return Task.FromResult<string?>(
                    "В выбранный день нет свободного окна такой длины. " +
                    "Выберите другой день или включите автоподбор.");
            }

            task.ScheduledTime = start.Value;
        }

        quests.Add(task);
        selectedDate = task.TargetDate;
        currentMonth = new DateTime(task.TargetDate.Year, task.TargetDate.Month, 1);
        activeTab = "work";

        return Task.FromResult<string?>(null);
    }

    // Сколько часов в этот день ещё можно занять задачами с учётом лимита нагрузки.
    // Лимит дня = 24 ч * процент из настроек (по умолчанию 80% = 19.2 ч).
    // Из лимита вычитаем дорогу и уже запланированные задачи.
    private double GetAvailableHours(DateTime date)
    {
        double dayLimit = 24.0 * scheduleConfig.MaxWorkloadPercent / 100.0;
        double used = GetCommuteHours(date) + GetTotalTasksHours(date);
        return Math.Round(dayLimit - used, 1);
    }

    // Ищет первый день, куда помещается задача, И в нём находит время начала.
    // Возвращает кортеж (день, время) или null.
    // "(DateTime Date, TimeSpan Start)?" = кортеж, который может отсутствовать.
    private (DateTime Date, TimeSpan Start)? FindDayForTask(int durationMinutes, DateTime from, int horizonDays)
    {
        double taskHours = durationMinutes / 60.0;

        for (int i = 0; i < horizonDays; i++)
        {
            DateTime day = from.AddDays(i);

            // 1) Проверка лимита нагрузки (шаг 4). Не хватает часов: пробуем следующий день.
            if (GetAvailableHours(day) < taskHours) continue;

            // 2) Проверка по часам: есть ли в этом дне реальное свободное окно?
            TimeSpan? start = FindFreeStart(day, durationMinutes);
            if (start != null) return (day, start.Value);
        }

        return null;
    }

    // Ищет время начала для задачи длиной durationMinutes в конкретный день.
    // Возвращает время (например, 09:00) или null, если подходящего окна нет.
    private TimeSpan? FindFreeStart(DateTime date, int durationMinutes)
    {
        var duration = TimeSpan.FromMinutes(durationMinutes);

        var windowStart = PlanDayStart;
        var windowEnd = PlanDayEnd;

        // Очень длинная задача ("весь день играть") не влезет в окно 08:00-22:00,
        // поэтому для неё разрешаем искать место в течение всех суток.
        if (duration > windowEnd - windowStart)
        {
            windowStart = TimeSpan.Zero;
            windowEnd = TimeSpan.FromHours(24);
        }

        // Для сегодняшнего дня нет смысла ставить задачу в прошлое:
        // начинаем с текущего времени, округлённого вверх до 15 минут.
        if (date.Date == DateTime.Today)
        {
            var now = DateTime.Now.TimeOfDay;
            var rounded = TimeSpan.FromMinutes(Math.Ceiling(now.TotalMinutes / 15) * 15);
            if (rounded > windowStart) windowStart = rounded;
        }

        // Собираем занятые промежутки этого дня и сортируем по началу.
        // Пропущенные задачи время не занимают, выполненные занимают.
        // GetValueOrDefault() достаёт TimeSpan из TimeSpan? (если пусто, будет 00:00).
        var busy = quests
            .Where(q => q.TargetDate.Date == date.Date && !q.IsSkipped && q.ScheduledTime.HasValue)
            .Select(q => new
            {
                Start = q.ScheduledTime.GetValueOrDefault(),
                End = q.ScheduledTime.GetValueOrDefault().Add(TimeSpan.FromMinutes(q.DurationMinutes))
            })
            .OrderBy(b => b.Start)
            .ToList();

        // cursor = "текущая точка", левый край ещё не проверенного свободного места
        var cursor = windowStart;

        foreach (var b in busy)
        {
            // Между cursor и началом занятого промежутка хватает места, и оно внутри окна?
            if (b.Start - cursor >= duration && cursor + duration <= windowEnd)
                return cursor;

            // Иначе перепрыгиваем за конец этого промежутка (если он правее cursor)
            if (b.End > cursor) cursor = b.End;
        }

        // Проверили все занятые промежутки. Остаётся хвост дня после последнего из них.
        return cursor + duration <= windowEnd ? cursor : null;
    }


    private void CompleteQuest(QuestItem quest)
    {
        quest.IsCompleted = true;
        player.AddGoldAndXP(quest.GetCalculatedReward());
    }

    private void SkipQuest(QuestItem quest) => quest.SkipTask();
    private void BuyReward(RewardItem reward) => player.TrySpendGold(reward.PriceGold);

    private List<QuestItem> questTemplates = new List<QuestItem>
{
    new QuestItem { Title = "Тренировка в зале", Priority = QuestPriority.High, Recurrence = RecurrenceRule.OffDaysOnly, DurationMinutes = 90, RewardGold = 100 },
    new QuestItem { Title = "Прочесть 20 страниц книги", Priority = QuestPriority.Medium, Recurrence = RecurrenceRule.Daily, DurationMinutes = 40, RewardGold = 40 },
    new QuestItem { Title = "Учеба: C# и Blazor", Priority = QuestPriority.High, Recurrence = RecurrenceRule.Daily, DurationMinutes = 120, RewardGold = 150 }
};
}