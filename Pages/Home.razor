@page "/"
@using LifeRPG.Models
@using System.Globalization @* Подключаем для русской локализации дат *@

<PageTitle>Life RPG — Главный экран</PageTitle>

<div class="d-flex flex-column vh-100 bg-dark text-white">

    @* ==================== 1. ФИКСИРОВАННАЯ ШАПКА ==================== *@
    <header class="d-flex justify-content-between align-items-center p-3 bg-black border-bottom border-secondary shadow sticky-top z-3">
        <div class="fs-5">
            🔥 Стрик: <strong class="text-danger">@currentStreak дней</strong>
        </div>

        <div class="fs-4">
            💰 Золото: <strong class="text-warning">@player.GoldBalance gold</strong>
        </div>

        <div class="d-flex align-items-center gap-2">
            <span class="fs-5 fw-bold">Уровень @player.Level</span>
            <div class="progress rounded-pill bg-secondary" style="width: 180px; height: 22px;">
                @{
                    var progressPercent = (player.CurrentXP * 100) / player.RequiredXP;
                }
                <div class="progress-bar bg-success rounded-pill fw-bold" style="width: @(progressPercent)%">
                    @(progressPercent)%
                </div>
            </div>
        </div>
    </header>

    @* Нижний блок *@
    <div class="d-flex flex-grow-1">

        @* ==================== 2. БОКОВОЕ МЕНЮ ==================== *@
        <nav class="p-3 bg-black border-end border-secondary" style="width: 220px;">
            <ul class="nav nav-pills flex-column gap-2">
                <li class="nav-item">
                    <button class="nav-link text-white w-100 text-start @(activeTab == "work" ? "active bg-primary" : "")"
                            @onclick='() => activeTab = "work"'>
                        🛠️ Работа
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link text-white w-100 text-start @(activeTab == "money" ? "active bg-primary" : "")"
                            @onclick='() => activeTab = "money"'>
                        💳 Деньги / Магазин
                    </button>
                </li>
            </ul>
        </nav>

        @* ==================== 3. ОСНОВНОЙ КОНТЕНТ ==================== *@
        <main class="flex-grow-1 p-4 overflow-auto">

            @if (activeTab == "work")
            {
                @* Динамический календарь с реальными датами ПК *@
                <section class="card bg-secondary text-white mb-4 p-3 shadow border-0">
                    <h4 class="card-title mb-3">📅 КАЛЕНДАРЬ НА 7 ДНЕЙ (Начиная с сегодня)</h4>
                    <div class="d-flex justify-content-between text-center gap-2">
                        @foreach (var day in weekDays)
                        {
                            @* Выделяем сегодняшнюю дату яркой рамкой border-warning *@
                            var isToday = day.Date == DateTime.Today;
                            <div class="p-2 bg-dark rounded flex-fill border @(isToday ? "border-warning border-2" : "border-secondary")">
                                @* Выводим название дня недели и число/месяц *@
                                <small class="d-block text-muted">@day.ToString("ddd, dd.MM", ruCulture)</small>
                                <strong>@(isToday ? "Сегодня 🌟" : "План 📝")</strong>
                            </div>
                        }
                    </div>
                </section>

                @* Задачи и тайм-менеджмент *@
                <section>
                    <h4 class="mb-3">⏰ Расписание и задачи на сегодня</h4>
                    <div class="list-group">
                        @foreach (var quest in quests)
                        {
                            <div class="list-group-item bg-dark text-white border-secondary d-flex justify-content-between align-items-center mb-2 rounded @(quest.IsCompleted ? "opacity-50" : "")">
                                <div>
                                    <h5 class="mb-1">
                                        @if (quest.ScheduledTime.HasValue)
                                        {
                                            <span class="badge bg-info me-2 fs-6">
                                                ⏱️ @quest.GetFormattedTimeRange()
                                            </span>
                                        }
                                        @quest.Title
                                    </h5>
                                    <small class="text-warning">+@quest.GetCalculatedReward() gold</small>
                                </div>

                                <div>
                                    @if (quest.IsCompleted)
                                    {
                                        <span class="badge bg-success fs-6">Выполнено 🎉</span>
                                    }
                                    else if (quest.IsSkipped)
                                    {
                                        <span class="badge bg-secondary fs-6">Задач нет 🛌</span>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-primary me-2" @onclick="() => CompleteQuest(quest)">
                                            Выполнить
                                        </button>

                                        @if (quest.Type == QuestType.Study)
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => SkipQuest(quest)">
                                                Сегодня учебы нет
                                            </button>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }
            else if (activeTab == "money")
            {
                <section>
                    <h4 class="mb-3">💳 Финансы и Магазин наград</h4>
                    <div class="row">
                        @foreach (var reward in rewards)
                        {
                            <div class="col-md-4 mb-3">
                                <div class="card bg-dark text-white border-secondary h-100 text-center">
                                    <div class="card-body">
                                        <h5>🎁 @reward.Title</h5>
                                        <p class="text-warning fs-5">@reward.PriceGold gold</p>
                                        <button class="btn btn-warning w-100"
                                                disabled="@(player.GoldBalance < reward.PriceGold)"
                                                @onclick="() => BuyReward(reward)">
                                            Купить
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }

        </main>
    </div>
</div>

@code {
    private PlayerProfile player = new PlayerProfile();
    private int currentStreak = 5;
    private string activeTab = "work";

    // Настройка русской культуры для красивого отображения дней ("сб", "вс", "пн")
    private CultureInfo ruCulture = new CultureInfo("ru-RU");

    // C#-свойство: автоматическая генерация списка из 7 дней, начиная с сегодняшнего дня на ПК
    private List<DateTime> weekDays => Enumerable.Range(0, 7)
        .Select(offset => DateTime.Today.AddDays(offset))
        .ToList();

    private List<QuestItem> quests = new List<QuestItem>
    {
        new QuestItem {
            Title = "Дневная смена на работе",
            RewardGold = 500,
            Type = QuestType.WorkShift,
            ScheduledTime = new TimeSpan(08, 00, 0),
            DurationMinutes = 720
        },
        new QuestItem {
            Title = "Учеба: Задание от куратора",
            RewardGold = 400,
            Type = QuestType.Study,
            ScheduledTime = new TimeSpan(17, 00, 0),
            DurationMinutes = 120
        },
        new QuestItem {
            Title = "Разработка Life RPG на C#",
            RewardGold = 300,
            Type = QuestType.PetProject,
            ScheduledTime = new TimeSpan(20, 00, 0),
            DurationMinutes = 90
        }
    };

    private List<RewardItem> rewards = new List<RewardItem>
    {
        new RewardItem { Title = "Попить пива вечером", PriceGold = 100 },
        new RewardItem { Title = "Просмотр фильма / сериала", PriceGold = 150 },
        new RewardItem { Title = "Заказать пиццу / фастфуд", PriceGold = 400 },
        new RewardItem { Title = "Весь день играть в видеоигры", PriceGold = 800 }
    };

    private void CompleteQuest(QuestItem quest)
    {
        quest.IsCompleted = true;
        player.AddGoldAndXP(quest.GetCalculatedReward());
    }

    private void SkipQuest(QuestItem quest)
    {
        quest.SkipTask();
    }

    private void BuyReward(RewardItem reward)
    {
        player.TrySpendGold(reward.PriceGold);
    }
}